{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micromargin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
